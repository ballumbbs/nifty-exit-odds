// ============================================================================
//  NIFTY ORB SPREAD  (Opening-Range Breakout for debit spreads) — Pine v5
//  Built for: one trend-day trade per day on Nifty 50, traded as a debit spread
// ----------------------------------------------------------------------------
//  RULES
//    1. Opening range = high/low of 09:15–09:30 IST
//    2. Breakout window 09:30–11:30 IST, max 1 trade a day
//       BULL: candle CLOSES above OR high, price above VWAP, ADX > 20
//       BEAR: candle CLOSES below OR low,  price below VWAP, ADX > 20
//    3. Trade it as a DEBIT SPREAD (you do this in Groww):
//       BULL: buy ATM CE + sell CE "spread width" points higher
//       BEAR: buy ATM PE + sell PE "spread width" points lower
//    4. Exits: candle closes back inside the range (breakout failed),
//       hard stop at the other side of the range, target in points,
//       or 15:00 IST time exit
//    5. Skips Tuesdays (weekly expiry) by default
//
//  SETUP: NSE:NIFTY, 15-minute chart -> Pine Editor -> paste -> Add to chart
//
//  BACKTEST NOTE: the tester trades Nifty SPOT (qty 65 = 1 lot). A spread
//  gains less than spot (capped at the spread width) but also loses less.
//  Use the tester to judge direction; paper-trade real spread prices before
//  using money.
// ============================================================================

//@version=5
strategy("Nifty ORB Spread", shorttitle="ORB", overlay=true, initial_capital=100000, default_qty_type=strategy.fixed, default_qty_value=65, commission_type=strategy.commission.cash_per_order, commission_value=80, max_labels_count=500)

// ---------------------------- INPUTS ----------------------------------------
orSess     = input.session("0915-0930", "Opening range (IST)")
entrySess  = input.session("0930-1130", "Breakout window (IST)")
exitSess   = input.session("1500-1530", "Time exit (IST)")
useVwap    = input.bool(true, "Require VWAP side")
useAdx     = input.bool(true, "Require ADX")
adxLen     = input.int(14, "ADX length", minval=1)
adxMin     = input.float(20, "ADX minimum")
targetPts  = input.float(100, "Target (Nifty points)", step=5)
useInside  = input.bool(true, "Exit if candle closes back inside range")
skipExpiry = input.bool(true, "Skip Tuesdays (weekly expiry)")
spreadW    = input.int(150, "Spread width (points)", step=50)
strikeStep = input.int(50, "Strike interval")
showDash   = input.bool(true, "Show dashboard")

// ---------------------------- OPENING RANGE ---------------------------------
inOR    = not na(time(timeframe.period, orSess, "Asia/Kolkata"))
inEntry = not na(time(timeframe.period, entrySess, "Asia/Kolkata"))
inExit  = not na(time(timeframe.period, exitSess, "Asia/Kolkata"))

var float orHigh = na
var float orLow  = na
var int tradesToday = 0

if timeframe.change("D")
    orHigh := na
    orLow := na
    tradesToday := 0

if inOR
    orHigh := na(orHigh) ? high : math.max(orHigh, high)
    orLow  := na(orLow) ? low : math.min(orLow, low)

orReady = not inOR and not na(orHigh)

// ---------------------------- FILTERS ---------------------------------------
vw = ta.vwap(hlc3)
[diP, diM, adx] = ta.dmi(adxLen, adxLen)
adxOk  = useAdx ? adx > adxMin : true
isTue  = dayofweek == dayofweek.tuesday
dayOk  = skipExpiry ? not isTue : true

flat = strategy.position_size == 0
canTrade = orReady and inEntry and flat and tradesToday < 1 and dayOk and adxOk

longSig  = canTrade and close > orHigh and (useVwap ? close > vw : true)
shortSig = canTrade and close < orLow and (useVwap ? close < vw : true)

atm = math.round(close / strikeStep) * strikeStep

// ---------------------------- ORDERS ----------------------------------------
if longSig
    strategy.entry("BULL", strategy.long)
    strategy.exit("BULL-x", "BULL", stop=orLow, limit=close + targetPts)
    tradesToday += 1
    alert("NIFTY ORB BULL: buy " + str.tostring(atm) + " CE, sell " + str.tostring(atm + spreadW) + " CE | Spot " + str.tostring(close, "#.##"), alert.freq_once_per_bar_close)

if shortSig
    strategy.entry("BEAR", strategy.short)
    strategy.exit("BEAR-x", "BEAR", stop=orHigh, limit=close - targetPts)
    tradesToday += 1
    alert("NIFTY ORB BEAR: buy " + str.tostring(atm) + " PE, sell " + str.tostring(atm - spreadW) + " PE | Spot " + str.tostring(close, "#.##"), alert.freq_once_per_bar_close)

// Breakout failed: close back inside the range
if useInside and strategy.position_size > 0 and close < orHigh
    strategy.close("BULL", comment="back inside")
    alert("NIFTY ORB: EXIT bull spread (back inside range)", alert.freq_once_per_bar_close)
if useInside and strategy.position_size < 0 and close > orLow
    strategy.close("BEAR", comment="back inside")
    alert("NIFTY ORB: EXIT bear spread (back inside range)", alert.freq_once_per_bar_close)

if inExit and not flat
    strategy.close_all(comment="15:00 exit")
    alert("NIFTY ORB: time exit, close the spread", alert.freq_once_per_bar_close)

// ---------------------------- PLOTS -----------------------------------------
plot(orHigh, "OR high", color=color.new(color.green, 0), linewidth=2, style=plot.style_linebr)
plot(orLow, "OR low", color=color.new(color.red, 0), linewidth=2, style=plot.style_linebr)
plot(useVwap ? vw : na, "VWAP", color=color.new(color.purple, 0), linewidth=2)
plotshape(longSig, "BULL", shape.labelup, location.belowbar, color.new(color.green, 0), text="BULL\nSPREAD", textcolor=color.white, size=size.small)
plotshape(shortSig, "BEAR", shape.labeldown, location.abovebar, color.new(color.red, 0), text="BEAR\nSPREAD", textcolor=color.white, size=size.small)
bgcolor(skipExpiry and isTue ? color.new(color.gray, 90) : na, title="Expiry day (skipped)")

// ---------------------------- DASHBOARD -------------------------------------
var table dash = table.new(position.top_right, 2, 7, bgcolor=color.new(color.black, 15), border_width=1, border_color=color.new(color.gray, 60))

if showDash and barstate.islast
    statusTxt = not dayOk ? "EXPIRY - SKIP" : tradesToday >= 1 ? "DONE TODAY" : not orReady ? "BUILDING RANGE" : not inEntry ? "WINDOW CLOSED" : not adxOk ? "CHOPPY - WAIT" : "WATCHING"
    table.cell(dash, 0, 0, "ORB — Nifty", text_color=color.yellow, text_size=size.small)
    table.cell(dash, 1, 0, statusTxt, text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 1, "OR high", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 1, str.tostring(orHigh, "#.##"), text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 2, "OR low", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 2, str.tostring(orLow, "#.##"), text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 3, "VWAP", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 3, close > vw ? "Above" : "Below", text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 4, "ADX", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 4, str.tostring(adx, "#.0"), text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 5, "Bull spread", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 5, "Buy " + str.tostring(atm) + " CE / Sell " + str.tostring(atm + spreadW) + " CE", text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 6, "Bear spread", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 6, "Buy " + str.tostring(atm) + " PE / Sell " + str.tostring(atm - spreadW) + " PE", text_color=color.white, text_size=size.small)
